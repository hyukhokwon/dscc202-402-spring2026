{
  "datasets": [
    {
      "name": "dc19aed0",
      "displayName": "Total Tweets Counter",
      "queryLines": [
        "SELECT COUNT(*) AS total_tweets\r\n",
        "FROM tweets_bronze;\r\n",
        "\r\n",
        "\r\n"
      ]
    },
    {
      "name": "64e64224",
      "displayName": "Tweets With Mentions Counter",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_with_mentions\r\n",
        "FROM tweets_silver\r\n",
        "WHERE mention IS NOT NULL;"
      ]
    },
    {
      "name": "327b6c26",
      "displayName": "Tweets Without Mentions Counter",
      "queryLines": [
        "SELECT COUNT(*) AS tweets_without_mentions\r\n",
        "FROM tweets_silver\r\n",
        "WHERE mention IS NULL;"
      ]
    },
    {
      "name": "adecd5e4",
      "displayName": "Top 10 Users by Tweet Count",
      "queryLines": [
        "SELECT user, COUNT(*) AS tweet_count\r\n",
        "FROM tweets_bronze\r\n",
        "GROUP BY user\r\n",
        "ORDER BY tweet_count DESC, user ASC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "c4bfbc7a",
      "displayName": "Top 10 Most Positively Mentioned",
      "queryLines": [
        "SELECT mention, positive - negative AS total_positive\r\n",
        "FROM tweets_gold_aggregated\r\n",
        "WHERE positive > negative\r\n",
        "ORDER BY total_positive DESC, mention ASC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "0663663b",
      "displayName": "Top 10 Most Negatively Mentioned",
      "queryLines": [
        "SELECT mention, negative - positive AS total_negative\r\n",
        "FROM tweets_gold_aggregated\r\n",
        "WHERE negative > positive\r\n",
        "ORDER BY total_negative DESC, mention ASC\r\n",
        "LIMIT 10;"
      ]
    },
